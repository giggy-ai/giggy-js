{
  "name": "@giggy-ai/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript and TypeScript SDK for the Giggy text-to-speech API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giggy-ai/giggy-js.git"
  },
  "homepage": "https://giggy.ai/docs/speech-api",
  "bugs": {
    "url": "https://github.com/giggy-ai/giggy-js/issues"
  },
  "keywords": [
    "giggy",
    "text-to-speech",
    "tts",
    "speech",
    "speech-synthesis",
    "voice-ai",
    "voice-agents",
    "typescript",
    "javascript",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
